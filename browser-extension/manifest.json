{
  "manifest_version": 3,
  "name": "ComplyAI - Security Questionnaire Auto-Filler",
  "version": "1.0.0",
  "description": "Auto-fill security questionnaires on OneTrust, Whistic, Loopio, CyberGRX, Google Forms, and more using ComplyAI's Answer Library",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "sidePanel",
    "contextMenus"
  ],
  "host_permissions": [
    "*://*.onetrust.com/*",
    "*://*.whistic.com/*",
    "*://*.loopio.com/*",
    "*://*.cybergrx.com/*",
    "*://*.google.com/forms/*",
    "*://*.typeform.com/*",
    "http://localhost:8080/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.onetrust.com/*",
        "*://*.whistic.com/*",
        "*://*.loopio.com/*",
        "*://*.cybergrx.com/*",
        "*://*.google.com/forms/*",
        "*://*.typeform.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ComplyAI Auto-Filler",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "injected.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "fill-all": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Auto-fill all detected questions on this page"
    }
  }
}
