# ComplyAI Frontend Environment Variables

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
# Where the Next server forwards /api requests it does not handle itself. Read
# on the server; never sent to the browser.
BACKEND_URL=http://localhost:8080

# Leave this unset. The browser calls the origin it loaded the page from, and
# the Next server proxies to BACKEND_URL above -- so there is no cross-origin
# request, and the backend permits none by default (CORS_ALLOWED_ORIGINS).
# Setting it points the browser straight at the backend, which then needs that
# origin allowed on the backend as well.
# NEXT_PUBLIC_API_URL=

# Keycloak Configuration
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8081
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=complyai-frontend
NEXT_PUBLIC_KEYCLOAK_REALM=complyai

# Feature Flags
NEXT_PUBLIC_ENABLE_MOCK_AUTH=false

# ---------------------------------------------------------------------------
# Offline fixtures (development only)
# ---------------------------------------------------------------------------
# When the API is unreachable the client throws ApiUnavailableError so the UI
# shows a real failure. Set this to "true" to fall back to built-in fixtures
# instead -- useful for frontend work without a backend running.
#
# This flag is ignored entirely in a production build: fabricated compliance
# answers must never be able to reach a real user.
NEXT_PUBLIC_USE_MOCK_DATA=false
