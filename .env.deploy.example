# Copy to .env on the server and fill in. Never commit the filled copy.

# Postgres password. Generate one: openssl rand -base64 32
DB_PASSWORD=

# The public HTTPS origin, e.g. https://app.quenaire.in
# Baked into the frontend bundle at build time -- changing it needs a rebuild.
PUBLIC_URL=

# Domain Caddy requests a certificate for, e.g. app.quenaire.in
# Its DNS A record must already point at this server.
DOMAIN=

# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=

# Hosted generation. Self-hosted deployments set LLM_PROVIDER=ollama instead
# and accept ~20s a question.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Sign-in (Keycloak)
# ---------------------------------------------------------------------------
# Keycloak's own database password. openssl rand -base64 32
# Only read the first time Postgres initialises; set it before the first start.
KEYCLOAK_DB_PASSWORD=

# The Keycloak administrator. This account can create users and change the
# realm's security settings -- treat it like a root password.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=

# Shared between Keycloak and the backend: how the application authenticates
# itself to create accounts during registration. openssl rand -base64 32
KEYCLOAK_BACKEND_SECRET=
